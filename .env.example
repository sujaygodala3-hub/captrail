# Copy this file to .env.local (same folder as package.json) and paste your key.
# .env* is in .gitignore, so your real key is never committed.
# Never put a real key in this example file.

# Used by api/analyze.js (image review) and api/voice.js (voice commands).
# Both call the model "claude-sonnet-5-5".
ANTHROPIC_API_KEY=

# Optional: private trained-model backend used by api/ml-bridge.js (must be https).
CAPTRAIL_ML_BACKEND_URL=
